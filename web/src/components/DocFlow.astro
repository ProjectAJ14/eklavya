---
/** A short, accessible process diagram. Keep the steps beside the owning prose. */
interface Props {
  title: string;
  caption: string;
  steps: { label: string; detail: string }[];
}
const { title, caption, steps } = Astro.props;
---

<figure class="doc-flow not-content">
  <figcaption>
    <strong>{title}</strong>
    <p>{caption}</p>
  </figcaption>
  <ol role="list" style={`--flow-count: ${steps.length}`}>
    {steps.map((step, index) => (
      <li>
        <span class="doc-flow__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <strong>{step.label}</strong>
        <p>{step.detail}</p>
        {index < steps.length - 1 && (
          <svg class="doc-flow__arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M3 12h17M14 6l6 6-6 6" />
          </svg>
        )}
      </li>
    ))}
  </ol>
</figure>

<style>
  .doc-flow { container-type: inline-size; margin: 1.75rem 0; }
  figcaption { margin-bottom: 1rem; }
  figcaption > strong { color: var(--ink); font-family: var(--font-disp); }
  p { margin: .4rem 0 0; color: var(--dim); font-size: .875rem; line-height: 1.6; }
  ol { display: grid; gap: 1.75rem; padding: 0; margin: 0; list-style: none; }
  li { position: relative; min-width: 0; padding: 1rem; border: 1px solid var(--line-2); background: var(--panel); }
  li > strong { display: block; color: var(--ink); font-size: .95rem; line-height: 1.4; }
  .doc-flow__number { display: block; margin-bottom: .5rem; color: var(--spot); font: .75rem var(--font-mono); }
  .doc-flow__arrow { position: absolute; width: 1.25rem; height: 1.25rem; bottom: -1.5rem; left: calc(50% - .625rem); transform: rotate(90deg); fill: none; color: var(--spot); stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  @container (min-width: 42rem) {
    ol { grid-template-columns: repeat(var(--flow-count), minmax(0, 1fr)); }
    .doc-flow__arrow { bottom: auto; left: auto; right: -1.5rem; top: calc(50% - .625rem); transform: none; }
  }
</style>

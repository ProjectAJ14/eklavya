ngIO()\n        self.assertEqual(main([\"2\", \"4\", \"4\", \"4\", \"5\", \"5\", \"7\", \"9\"], out=out), 0)\n        self.assertEqual(\n            out.getvalue().splitlines(),\n            [\"mean: 5.0\", \"median: 4.5\", \"mode: 4.0\", \"stdev: 2.0\"],\n        )\n\n    def test_no_args(self):\n        with redirect_stderr(io.StringIO()):\n            self.assertEqual(main([], out=io.StringIO()), 1)\n\n    def test_bad_number(self):\n        with redirect_stderr(io.StringIO()):\n            self.assertEqual(main([\"1\", \"x\"], out=io.StringIO()), 1)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\nEOF\ncat > README.md <<'EOF'\n# scratch\n\nSmall statistics helpers.\n\n## Library\n\n`calc.py` provides `add`, `mean`, `median`, `mode` (smallest value on ties) and `stdev` (population standard deviation). The statistics functions raise `ValueError` on empty input.\n\n## CLI\n\n    python3 cli.py 2 4 4 4 5 5 7 9\n\nPrints:\n\n    mean: 5.0\n    median: 4.5\n    mode: 4.0\n    stdev: 2.0\n\nExits with status 1 and an error on stderr if no numbers are given or an argument isn't a number.\n\n## Tests\n\n    python3 -m unittest\nEOF\npython3 cli.py 2 4 4 4 5 5 7 9; python3 -m unittest 2>&1 | tail -4"}}]}}

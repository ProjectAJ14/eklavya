{
  "name": "eklavya-mcp",
  "version": "1.0.1",
  "description": "Eklavya MCP server — local knowledge graph, spaced repetition, and quiz gating for agent-assisted learning.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProjectAJ14/eklavya.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/ProjectAJ14/eklavya#readme",
  "bugs": {
    "url": "https://github.com/ProjectAJ14/eklavya/issues"
  },
  "author": "Ajay Kumar",
  "keywords": [
    "mcp",
    "claude-code",
    "learning",
    "spaced-repetition",
    "sm-2",
    "knowledge-graph",
    "tutor",
    "mentorship"
  ],
  "type": "module",
  "bin": {
    "eklavya-mcp": "dist/server.js",
    "eklavya": "dist/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^12.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}

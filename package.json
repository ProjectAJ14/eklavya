{
  "name": "eklavya-release-tooling",
  "private": true,
  "description": "Release tooling for the Eklavya plugin. The published package lives in mcp/.",
  "scripts": {
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run --no-ci",
    "eval": "node eval/harness.mjs",
    "mascot:generate": "node scripts/generate-mascot.mjs",
    "mascot:check": "node scripts/generate-mascot.mjs --check"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.0.3",
    "@semantic-release/git": "^10.0.1",
    "semantic-release": "^24.2.3"
  }
}

#!/bin/sh
# Exit 0 if committing is allowed, 1 if Eklavya's gate is holding it.
#
# This is what makes enforcement editor-agnostic (PRD §9.4): the same check runs
# from a bare terminal, VS Code, or Cursor via the git pre-commit hook.
#
# It fails OPEN. A missing jq, a missing sqlite3, a missing database or an
# unreadable config lets the commit through with a warning. A learning tool that
# bricks commits when a dependency is absent gets uninstalled, and an unpassable
# gate teaches nothing.
#
# It reads this project's config and nothing else -- never ~/.eklavya/config.json.
# That is deliberate: a git hook installed once must not start blocking commits
# because someone flipped a global setting. Gating a codebase is a per-project
# decision, stated in that project's own file.
#
# That file used to be <repo>/.eklavya.json, committed. It is not any more: a
# project's settings say how *you* want to be taught in that codebase, and a
# committed file made one person's choice everybody's. They now live at
# ~/.eklavya/projects/<checkout path with separators as dashes>/config.json,
# alongside the global config and keyed the way ~/.claude/projects/ keys its own.
# Nothing Eklavya writes lands in a checkout.
#
# The node half migrates a leftover .eklavya.json out of the repo automatically.
# This script does not -- a git pre-commit hook is the wrong place to start
# rewriting somebody's working tree -- so it reads the legacy file as a fallback
# and lets the next ordinary session do the move.

set -u

eklavya_home() { printf '%s' "${EKLAVYA_HOME:-$HOME/.eklavya}"; }
eklavya_db()   { printf '%s' "${EKLAVYA_DB:-$(eklavya_home)/knowledge.db}"; }

REPO=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -n "$REPO" ] || exit 0

# A linked worktree is a branch of the same codebase, not a project to configure
# again -- the same fold `mainRepoRoot` applies on the node side. `--git-common-dir`
# points at the main checkout's .git for a worktree and at this one's otherwise,
# so stripping the trailing /.git yields the checkout that owns the settings.
PROJECT="$REPO"
COMMON=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || COMMON=''
case "$COMMON" in
  */.git) CANDIDATE=${COMMON%/.git}; [ -d "$CANDIDATE" ] && PROJECT="$CANDIDATE" ;;
esac

# The slug `projectSlug` builds: the absolute path with separators as dashes.
SLUG=$(printf '%s' "$PROJECT" | tr '/\\:' '-')
CONFIG="$(eklavya_home)/projects/$SLUG/config.json"

# The pre-move location, read only while a checkout still has one.
[ -f "$CONFIG" ] || CONFIG="$REPO/.eklavya.json"

# Only projects that explicitly opt in are gated.
[ -f "$CONFIG" ] || exit 0

if ! command -v jq >/dev/null 2>&1; then
  printf 'eklavya: jq not found, skipping the commit gate.\n' >&2
  exit 0
fi
if ! command -v sqlite3 >/dev/null 2>&1; then
  printf 'eklavya: sqlite3 not found, skipping the commit gate.\n' >&2
  exit 0
fi

# `quiz.enforced`, with the retired `mode` dial honoured as a fallback -- this
# script meets configs written years before it.
#
# Spelled out with if/elif rather than jq's `//`, which is an alternative
# operator and not a null-coalescing one: `false // X` evaluates to X, so the
# obvious `.quiz.enforced // (.mode == "enforced")` would read an explicit
# `"enforced": false` as unset and fall through to a stale `mode` left in the
# same file. That is a gate holding commits after somebody switched it off.
#
# The `enabled == false` arm mirrors what `coerce()` does in the TypeScript: a
# gate with no questions behind it can never be passed, so it must not hold.
ENFORCED=$(jq -r '
  if .quiz.enabled == false then false
  elif .quiz.enforced != null then .quiz.enforced
  else (.mode == "enforced") end
' "$CONFIG" 2>/dev/null) || exit 0
[ "$ENFORCED" = "true" ] || exit 0

DB=$(eklavya_db)
[ -f "$DB" ] || exit 0

ESCAPED=$(printf '%s' "$REPO" | sed "s/'/''/g")
GATE=$(sqlite3 -noheader -batch -cmd ".timeout 2000" "$DB" "
  SELECT passed || '|' || required || '|' || answered
    FROM gates
   WHERE repo = '$ESCAPED'
   ORDER BY updated_at DESC
   LIMIT 1;" 2>/dev/null) || exit 0

# No gate for this repo means Eklavya never taught anything here, so there is
# nothing to have passed.
[ -n "$GATE" ] || exit 0

PASSED=$(printf '%s' "$GATE" | cut -d'|' -f1)
REQUIRED=$(printf '%s' "$GATE" | cut -d'|' -f2)
ANSWERED=$(printf '%s' "$GATE" | cut -d'|' -f3)

[ "$PASSED" = "1" ] && exit 0

cat >&2 <<EOF

  Eklavya is holding this commit.

  You have answered $ANSWERED of $REQUIRED concepts from this session's work.
  Answering is not the same as passing: a skipped or wrong answer counts here
  but not towards the gate. /eklavya:gate has the passing count.

  Open Claude Code in this repo and run /eklavya:quiz to finish, then commit again.

  To see what is outstanding:  /eklavya:gate
  To turn this off:  eklavya config set quiz.enforced false --project

EOF
exit 1

  "cards": [
    {
      "dot": "emerald",
      "title": "One turn of the loop",
      "items": [
        "1 \u00b7 the agent calls log_session_concepts while it works",
        "2 \u00b7 PostToolUse reads it and returns additionalContext",
        "3 \u00b7 an instruction to ask \u2014 never the question itself",
        "4 \u00b7 the model plans, asks, grades with record_attempt (panel: present_question)",
        "Mid-task and Stop questions share one session budget"
      ]
    },
    {
      "dot": "amber",
      "title": "Eight hooks, six events",
      "items": [
        "SessionStart \u2014 banner + context; SubagentStart \u2014 context",
        "UserPromptSubmit \u2014 one line, only when a session logged nothing",
        "PostToolUse \u2014 capture plus two checkpoint matchers",
        "Stop \u2014 context continues work; memory closes due batches",
        "PreToolUse \u2014 deny git commit (Bash); a file's past work (Read)"
      ]
    },
    {
      "dot": "rose",
      "title": "Server, state and boundaries",
      "items": [
        "stdout is the protocol; diagnostics are forced to stderr",
        "retryOnBusy wraps handlers; openDb seeds, then packs",
        "Session gate + opt-in Git hook; operational failures allow commits",
        "A failed memory job backs off; auth or quota pauses the queue, which rechecks itself",
        "No config in a checkout; settings are per developer, not committed"
      ]
    }
  ]

{
  "all": true,
  "src": [
    "src"
  ],
  "include": [
    "dist/**/*.js",
    "src/**/*.ts"
  ],
  "exclude": [
    "test/**"
  ],
  "exclude-after-remap": true,
  "reporter": [
    "text-summary",
    "json-summary",
    "html"
  ],
  "reports-dir": "coverage",
  "check-coverage": true,
  "lines": 100,
  "statements": 100,
  "functions": 100,
  "branches": 100
}

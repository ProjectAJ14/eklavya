{
  "_comment": "Copy to .eklavya.json at a repo root to pin Eklavya's behaviour for that project. Repo settings win over ~/.eklavya/config.json — including a contributor's personal focus, so set focus here only when you mean to.",
  "_mode": "How hard Eklavya pushes: ambient | enforced | off.",
  "mode": "enforced",
  "_focus": "What Eklavya teaches, independent of mode: project | concept | learn.",
  "focus": "project",
  "_focus_topic": "Only used by focus \"learn\". The topic to teach, e.g. \"caching\".",
  "_cadence": "When Eklavya asks: interleaved | end. \"interleaved\" (default) asks one question mid-task as each concept is logged, so the developer learns while the agent works; the end-of-task quiz then only sweeps up the remainder. \"end\" waits until the task is finished.",
  "cadence": "interleaved",
  "_difficulty": "How hard questions on this project may get: auto | easy | medium | hard. \"auto\" (default) earns the band -- every project starts at easy (tiers 1-2), then medium (2-4), then hard (3-5). A literal level pins it and stops progression: \"easy\" here keeps an onboarding codebase gentle for every contributor, whatever they set for themselves.",
  "difficulty": "easy",
  "_level_up_after": "Passing answers needed in this project before the band moves up. The distinct-concept floor scales with it, so a shortened runway stays reachable.",
  "level_up_after": 100,
  "_level_up_accuracy": "Minimum accuracy over those answers, declines excluded. Volume alone is not readiness.",
  "level_up_accuracy": 0.7,
  "pass_threshold": 0.7,
  "_max_questions_per_task": "A budget for the whole session, shared by mid-task checkpoints and the end-of-task sweep — not a batch size.",
  "max_questions_per_task": 4,
  "min_minutes_between_quizzes": 20,
  "_min_minutes_between_checkpoints": "Floor between mid-task questions, so eight concepts logged in one call cannot become eight questions in a row.",
  "min_minutes_between_checkpoints": 4,
  "max_new_concepts_per_session": 8,
  "max_stop_blocks_per_session": 3
}

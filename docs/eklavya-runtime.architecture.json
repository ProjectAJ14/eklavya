      },
      {
        "id": "memory-path",
        "label": "What gets remembered",
        "focus": [
          "hooks",
          "memory",
          "db",
          "session"
        ],
        "note": "Tool evidence is redacted before storage; batches feed a session summary and later recall. Memory does not change mastery."
      }
